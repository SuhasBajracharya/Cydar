# Copy this to `.env` in the repo root and fill in your values.
# Backend loads it via python-dotenv (see config/settings.py).
# Never commit the real `.env` — it holds your API keys.
#
# Add a key for each provider you use. Providers WITHOUT a key still appear
# in the web UI picker, marked "(no key)". Base URLs are optional (sane
# defaults in backend/agent/providers.py) — set them only to override.

# --- DeepSeek (direct) ---
# OpenAI-compatible endpoint, e.g. https://api.deepseek.com
DEEPSEEK_BASE_URL=
# Your DeepSeek API key (metered — keep it secret)
DEEPSEEK_API_KEY=
# Default model id for the deepseek provider
DEEPSEEK_MODEL=deepseek-chat

# --- OpenRouter (many models, one key) ---
OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers OpenRouter recommends:
#OPENROUTER_REFERER=
#OPENROUTER_TITLE=Cydar

# --- AgentRouter ---
AGENTROUTER_API_KEY=
#AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# --- NVIDIA NIM ---
NVIDIA_API_KEY=
#NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- OpenCode Zen ---
# Key from opencode.ai/auth, env name matches Docker/OpenCode convention.
OPENCODE_API_KEY=
#OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# --- Ollama (local, no API key needed) ---
# OpenAI-compatible endpoint served by `ollama serve`. Always shown as
# configured in the picker — just make sure Ollama is running and the model
# is pulled, e.g. `ollama pull qwen3:8b`. Base URL override only if Ollama
# runs elsewhere; OLLAMA_MODEL overrides the default model id.
#OLLAMA_BASE_URL=http://localhost:11434/v1
#OLLAMA_MODEL=qwen3:8b

# --- Signup mailbox (trial registrations) ---
# A DEDICATED throwaway inbox the agent uses to receive verification mail
# for trial signups — never your personal mailbox (the worker reads it).
# Gmail needs 2FA + an App Password; any IMAP-SSL provider works.
#SIGNUP_IMAP_HOST=imap.gmail.com
#SIGNUP_IMAP_PORT=993
#SIGNUP_IMAP_USER=fyp.bounty.runner@gmail.com
#SIGNUP_IMAP_PASS=xxxx-xxxx-xxxx-xxxx
